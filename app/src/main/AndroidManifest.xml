<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:name=".FinApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.FinApp">

        <activity
            android:name=".HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".RegisterActivity"/>
        <activity android:name=".HistoryActivity"/>
        <activity android:name=".AnalyticsActivity"/>
        <activity android:name=".SettingsActivity"/>
        <activity android:name=".CurrencyActivity"/>
        <activity android:name=".ThemeActivity"/>
        <activity android:name=".CategoryEditorActivity"/>
        <activity android:name=".MonthStartActivity"/>

        <activity android:name=".LoginActivity"/>
    </application>

</manifest>
