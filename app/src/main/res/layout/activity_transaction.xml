<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:text="Добавить операцию"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="Тип операции"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <!-- КНОПКИ ТИПОВ -->

        <Button
            android:id="@+id/btnIncome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Доход"
            android:textColor="#18B26B"
            android:backgroundTint="#E8FFF3"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnExpense"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Расход"
            android:textColor="#E64545"
            android:backgroundTint="#FFECEC"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnCash"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Снятие наличных"
            android:textColor="#7A4DFF"
            android:backgroundTint="#F1E9FF"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/btnTransfer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Перевод"
            android:textColor="#3D6CFF"
            android:backgroundTint="#E8F2FF"
            android:layout_marginTop="8dp"/>

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Сумма"
            android:inputType="numberDecimal"
            android:layout_marginTop="24dp"/>

        <!-- Способ оплаты (по умолчанию скрыт) -->
        <LinearLayout
            android:id="@+id/layoutPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="16dp">

            <TextView
                android:text="Способ оплаты"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioGroup
                android:id="@+id/radioGroupPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <RadioButton
                    android:text="Наличные"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:text="Безналичные"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </RadioGroup>
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveTransaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сохранить операцию"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</ScrollView>